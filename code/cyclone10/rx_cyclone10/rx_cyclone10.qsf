set_instance_assignment -name POWER_UP_LEVEL LOW -to power_on_count[*]

# Bank 3 - 1.8 V: ADC control and 24.576 MHz clock
set_location_assignment PIN_49 -to ADC_SCL
set_location_assignment PIN_50 -to ADC_SDA
set_location_assignment PIN_52 -to ACLK_FPGA
set_location_assignment PIN_55 -to FPGA_CLK
set_instance_assignment -name IO_STANDARD "1.8 V" -to ADC_SCL
set_instance_assignment -name IO_STANDARD "1.8 V" -to ADC_SDA
set_instance_assignment -name IO_STANDARD "1.8 V" -to ACLK_FPGA
set_instance_assignment -name IO_STANDARD "1.8 V" -to FPGA_CLK

# Bank 4 - 1.8 V: 30 MHz clock and TLV320ADC6120 serial audio interface
set_location_assignment PIN_65 -to ADC_FSYNC
set_location_assignment PIN_66 -to ADC_BCLK
set_location_assignment PIN_67 -to ADC_SDOUT
set_instance_assignment -name IO_STANDARD "1.8 V" -to ADC_FSYNC
set_instance_assignment -name IO_STANDARD "1.8 V" -to ADC_BCLK
set_instance_assignment -name IO_STANDARD "1.8 V" -to ADC_SDOUT

# Bank 7 - 3.3 V: MCU SPI1
